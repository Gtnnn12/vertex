{
  "name": "vertex",
  "version": "1.0.0",
  "private": true,
  "description": "Open, self-hosted communication platform — text, voice, video, and federation",
  "license": "AGPL-3.0-only",
  "author": "gtnn12",
  "homepage": "https://github.com/gtnn12/VERTEX",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtnn12/VERTEX.git"
  },
  "scripts": {
    "dev:server": "pnpm --filter @vertex/server dev",
    "dev:web": "pnpm --filter @vertex/web dev",
    "dev": "pnpm --parallel --filter @vertex/server --filter @vertex/web dev",
    "build:shared": "pnpm --filter @vertex/shared build",
    "build:server": "pnpm --filter @vertex/server build",
    "build:web": "pnpm --filter @vertex/web build",
    "build": "pnpm --filter @vertex/shared build && pnpm --filter @vertex/server build && pnpm --filter @vertex/web build",
    "typecheck": "pnpm --filter @vertex/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:desktop": "pnpm --filter @vertex/desktop dev",
    "build:desktop": "pnpm --filter @vertex/desktop build",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "png-to-ico": "^2.1.8",
    "png2icons": "^2.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "sharp"
    ],
    "patchedDependencies": {
      "uiohook-napi@1.5.5": "patches/uiohook-napi@1.5.5.patch"
    }
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}